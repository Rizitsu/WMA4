{
  "info": {
    "name": "Rental POS System API (Final Term)",
    "description": "Endpoint collection for the Rental POS / Sales Management System, including authentication. Set the `base_url` collection variable to your server root, e.g. http://localhost/WM4Mid-main (no trailing slash).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/WM4Mid-main"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login.php",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login.php"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Authenticates user, creates a PHP session, and returns CSRF token."
          }
        },
        {
          "name": "Logout User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/logout.php",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "logout.php"
              ]
            },
            "description": "Destroys the active session and logs out the user."
          }
        }
      ]
    },
